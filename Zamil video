    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const generateBtn = document.getElementById('generate-btn');
            const progressBar = document.getElementById('progress-bar');
            const statusMessage = document.getElementById('status-message');
            const successMessage = document.getElementById('success-message');
            
            generateBtn.addEventListener('click', function() {
                // Reset UI
                progressBar.style.width = '0%';
                statusMessage.textContent = 'Preparing assets...';
                successMessage.style.display = 'none';
                
                // Simulate video generation progress
                let progress = 0;
                const interval = setInterval(() => {
                    progress += 5;
                    progressBar.style.width = progress + '%';
                    
                    if (progress === 5) {
                        statusMessage.textContent = 'Rendering opening sequence...';
                    } else if (progress === 20) {
                        statusMessage.textContent = 'Adding team footage...';
                    } else if (progress === 40) {
                        statusMessage.textContent = 'Processing family scene...';
                    } else if (progress === 60) {
                        statusMessage.textContent = 'Creating calligraphy effect...';
                    } else if (progress === 80) {
                        statusMessage.textContent = 'Finalizing closing montage...';
                    } else if (progress === 90) {
                        statusMessage.textContent = 'Adding music and sound effects...';
                    } else if (progress >= 100) {
                        clearInterval(interval);
                        statusMessage.textContent = 'Video rendering complete!';
                        successMessage.style.display = 'block';
                        
                        // Simulate download button after a delay
                        setTimeout(() => {
                            generateBtn.innerHTML = '<i class="fas fa-download"></i> Download Video';
                            generateBtn.onclick = function() {
                                alert('Video download would start now in a real application.');
                            };
                        }, 1000);
                    }
                }, 200);
            });
        });
    </script>
